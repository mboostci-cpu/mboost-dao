[Unit]
Description=MBOOST CV DAO web
After=network.target
[Service]
User=mboostcv
Group=mboostcv
WorkingDirectory=/opt/mboost-cv-dao
EnvironmentFile=/etc/mboost-cv-dao.env
ExecStart=/opt/mboost-cv-dao/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8012 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mboost-cv-dao
UMask=0077
MemoryMax=1200M
[Install]
WantedBy=multi-user.target
